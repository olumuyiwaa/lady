# App
NODE_ENV=development
PORT=8000
# Comma-separated: the public site and the admin site both call this API.
# Production: FRONTEND_URL=https://todcleaning.nl,https://admin.todcleaning.nl
FRONTEND_URL=http://localhost:3000
# Base domain for the host-resolved public booking widget — a business's
# widget is reachable at <subdomain>.WIDGET_BASE_DOMAIN, or their own
# customDomain if they've set one. Used by resolveBusinessFromHost; the
# slug-resolved widget (/widget-embed/:subdomain) works without this set.
WIDGET_BASE_DOMAIN=localhost

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/todcleaning

# Redis
REDIS_URL=redis://localhost:6379

NOTIFICATION_QUEUE=true

# JWT
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@todcleaning.nl
# Where messages from the public site's contact form are emailed.
# Comma-separated. They are always saved to the admin inbox either way.
# Used when the business has no contact email set.
PLATFORM_INBOX_EMAIL=support@todcleaning.nl

# SMS / OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp (Twilio). Sender must be a WhatsApp-enabled Twilio number. A business can only
# start a conversation with an approved template: create one per message and language
# (node scripts/printWhatsappTemplates.js prints the texts) and set its Content SID:
#   TWILIO_WA_CONTENT_<MESSAGE>_<NL|EN>=HX...   e.g. TWILIO_WA_CONTENT_BOOKINGCONFIRMED_NL
# A message without a template goes out as SMS. Only customers who opted in get WhatsApp.
TWILIO_WHATSAPP_FROM=
# Public base URL of this API (no trailing slash). Used to verify Twilio's signature on
# POST /api/v1/webhooks/whatsapp, so it must match the URL set in the Twilio console.
PUBLIC_API_URL=https://api.todcleaning.nl
# Language for customers with none stored (nl or en).
DEFAULT_CUSTOMER_LANGUAGE=nl

# Push (cleaner app). Either the JSON blob, or the three values below it.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# File storage (DigitalOcean Spaces / S3-compatible)
DO_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
DO_SPACES_REGION=ams3
DO_SPACES_BUCKET=todcleaning-uploads
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Optional — set if Spaces sits behind a CDN so public branding asset URLs
# (logo, site hero image, gallery) use the CDN host instead of the raw
# Spaces endpoint. Leave unset to use the default Spaces public URL.
DO_SPACES_CDN_ENDPOINT=

# Stripe: payments go straight to Tod Cleaning Services' own Stripe account
STRIPE_SECRET_KEY=
# One webhook endpoint pointing at /api/v1/webhooks/stripe (Account events).
STRIPE_WEBHOOK_SECRETS=
# Legacy single secret, still honoured.
STRIPE_WEBHOOK_SECRET=

# Always 0: there is no platform, Tod Cleaning Services keeps the full payment.
PLATFORM_APPLICATION_FEE_BPS=0
# Base URL of the admin site: invite and password-reset emails link here.
# Production: APP_URL=https://admin.todcleaning.nl
APP_URL=http://localhost:3000

# Storefront cache invalidation — must match REVALIDATE_SECRET in the frontend.
# The backend calls POST <url>/api/revalidate after branding/services/hours changes.
# Defaults to FRONTEND_URL when unset; set STOREFRONT_REVALIDATE_URL if the
# frontend is on a different internal host than the public FRONTEND_URL.
REVALIDATE_SECRET=
STOREFRONT_REVALIDATE_URL=

# Notification worker — where failed-job alerts are sent.
ADMIN_EMAIL=

# Behind a reverse proxy / load balancer: number of proxy hops to trust so
# rate limiting sees real client IPs. Defaults to 1 in production.
TRUST_PROXY=1
# Interactive API docs are disabled in production unless this is true.
ENABLE_API_DOCS=false

# Recurring visits are generated this many days ahead.
RECURRING_LOOKAHEAD_DAYS=21
# Set true to have Stripe Tax add BTW/VAT to the platform's own invoices.
STRIPE_AUTOMATIC_TAX=false

# Job payments. iDEAL must also be enabled in the platform's Stripe
# payment-method settings; it only works for EUR.
# Leave empty to use Stripe's dynamic payment methods (iDEAL appears for EUR when
# enabled in the Stripe dashboard). Set e.g. "card,ideal" to force a fixed list.
CHECKOUT_PAYMENT_METHODS=
# Job payments are DIRECT charges on the business's own Stripe account: the
# business is merchant of record and pays Stripe's fees; Tod Cleaning Services holds no funds.
# Minutes an unpaid deposit holds its slot (30-1440).
DEPOSIT_HOLD_MINUTES=60
# Cleaner payouts via Stripe Transfers are unverified with direct charges; keep
# off and use manual "mark as paid" until proven in test mode.
ENABLE_STRIPE_CLEANER_PAYOUTS=false
# ISO country for cleaners' Stripe Express (payout) accounts, e.g. NL.
PLATFORM_COUNTRY=NL

# Customer portal one-time-code sessions
PORTAL_TOKEN_EXPIRY=24h

# Geocoding / service areas
GOOGLE_MAPS_API_KEY=
GOOGLE_DISTANCE_MATRIX_API_KEY=

# Default currency (ISO 4217) for new businesses and any payment that does not
# carry its own. Each business can set its own (Business.currency).
DEFAULT_CURRENCY=eur
# Country calling code assumed for phone numbers written nationally ("06 ...").
# See src/lib/phone.js. Defaults to the Netherlands.
DEFAULT_PHONE_COUNTRY_CODE=31
# Locale for dates/amounts in customer messages.
DEFAULT_LOCALE=nl-NL

# --- Public booking widget abuse controls ---
# Cloudflare Turnstile secret. When set, POST /widget/.../bookings and /waitlist
# require a valid captchaToken (the widget must render the Turnstile challenge).
TURNSTILE_SECRET_KEY=
# Max bookings one phone/email may create through the public form per 24 h.
WIDGET_MAX_BOOKINGS_PER_CUSTOMER_PER_DAY=5

# --- Worker tuning ---
# Hours ahead to send booking reminders (default 24).
REMINDER_HOURS_AHEAD=24
# Cron expression for the reminder daemon (default: every hour).
REMINDER_CRON=0 * * * *
# Cron expression for the recurring-booking daemon (default: every 5 minutes).
RECURRING_CRON=*/5 * * * *
# Port the recurring daemon's health-check HTTP server listens on (default 4001).
RECURRING_DAEMON_PORT=4001

# --- BTW / invoicing ---
# Prices are VAT-inclusive. Platform default when a business/service has no rate (basis points, 2100 = 21%).
DEFAULT_VAT_RATE_BPS=2100

# First-run setup (npm run seed)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FIRST_NAME=
OWNER_LAST_NAME=
BUSINESS_NAME=Tod Cleaning Services
BUSINESS_SLUG=todcleaning
# Optional: pin the business id printed by the seed
BUSINESS_ID=
